{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"ThaiUkrainianWordAnalysis",
  "type":"object",
  "required":["input","segmentation_status","status","syllables","phonemic_ipa","phonetic_ipa","warnings"],
  "properties":{
    "input":{"type":"string"},
    "segmentation_status":{"type":"string","enum":["explicit"]},
    "status":{"type":"string"},
    "syllables":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["position","analysis"],
        "properties":{
          "position":{
            "type":"object",
            "required":["index","total","label"],
            "properties":{
              "index":{"type":"integer","minimum":0},
              "total":{"type":"integer","minimum":1},
              "label":{"type":"string","enum":["standalone","initial","medial","final"]}
            },
            "additionalProperties":false
          },
          "analysis":{"$ref":"analysis.schema.json"}
        },
        "additionalProperties":false
      }
    },
    "phonemic_ipa":{"type":"string"},
    "phonetic_ipa":{"type":"string"},
    "warnings":{"type":"array","items":{"type":"string"}}
  },
  "additionalProperties":false
}
