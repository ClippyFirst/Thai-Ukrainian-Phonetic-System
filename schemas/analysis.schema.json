{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"ThaiUkrainianSyllableAnalysis",
  "type":"object",
  "required":["input","normalized","status"],
  "properties":{
    "input":{"type":"string"},
    "normalized":{"type":"string"},
    "grapheme_order":{"type":"array","items":{"type":"string"}},
    "onset":{"type":"array","items":{"type":"string"}},
    "onset_class":{"type":["string","null"]},
    "vowel":{"type":["string","null"]},
    "vowel_id":{"type":["string","null"]},
    "vowel_length":{"type":["string","null"],"enum":["short","long",null]},
    "coda":{"type":["string","null"]},
    "coda_ipa":{"type":["string","null"]},
    "tone_mark":{"type":["string","null"]},
    "live_dead":{"type":["string","null"],"enum":["live","dead",null]},
    "tone":{"type":["object","null"]},
    "phonemic_ipa":{"type":["string","null"]},
    "phonetic_ipa":{"type":["string","null"]},
    "ukrainian_candidates":{"type":"array"},
    "selected_candidate":{"type":["string","null"]},
    "rules_applied":{"type":"array","items":{"type":"string"}},
    "warnings":{"type":"array","items":{"type":"string"}},
    "sources":{"type":"array","items":{"type":"string"}},
    "status":{"type":"string"}
  },
  "additionalProperties":true
}
